/**
 * Builder pattern — fluent, step-by-step construction of an immutable
 * `${TYPE_NAME}` value object.
 *
 * Replace the placeholder fields (name, quantity, active) with the real
 * attributes of your domain object. Cross-field validation belongs in
 * `Builder.build()` so callers never see a partially-constructed instance.
 */

// Module-private handshake: only ${TYPE_NAME}Builder can mint a ${TYPE_NAME}.
const BUILDER_KEY: unique symbol = Symbol("${TYPE_NAME}.build");

export class ${TYPE_NAME} {
  readonly name: string;
  readonly quantity: number;
  readonly active: boolean;

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  private constructor(token: typeof BUILDER_KEY, data: any) {
    if (token !== BUILDER_KEY) {
      throw new Error("Use ${TYPE_NAME}.builder(...) to construct a ${TYPE_NAME}.");
    }
    const d = data as { name: string; quantity: number; active: boolean };
    this.name = d.name;
    this.quantity = d.quantity;
    this.active = d.active;
    Object.freeze(this);
  }

  static builder(name: string): ${TYPE_NAME}Builder {
    return new ${TYPE_NAME}Builder(name);
  }

  /** @internal — do not call from outside ${TYPE_NAME}Builder. */
  static _mint(data: { name: string; quantity: number; active: boolean }): ${TYPE_NAME} {
    return new ${TYPE_NAME}(BUILDER_KEY, data);
  }
}

export class ${TYPE_NAME}Builder {
  #quantity = 1;
  #active = true;

  constructor(private readonly name: string) {
    if (name.trim() === "") {
      throw new Error("name must not be blank");
    }
  }

  quantity(q: number): this {
    this.#quantity = q;
    return this;
  }

  active(a: boolean): this {
    this.#active = a;
    return this;
  }

  build(): ${TYPE_NAME} {
    if (this.#quantity < 0) {
      throw new Error(`quantity must be non-negative, got \${this.#quantity}`);
    }
    return ${TYPE_NAME}._mint({
      name: this.name,
      quantity: this.#quantity,
      active: this.#active,
    });
  }
}
